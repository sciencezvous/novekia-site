# Formulaire de contact (ne jamais committer les valeurs réelles)
RESEND_API_KEY=
CONTACT_TO=contact@novekia.fr
CONTACT_FROM=

# Rapport de pré-audit (optionnel : sinon CONTACT_FROM est utilisé)
AUDIT_REPORT_FROM=

# Funnel commercial Visibility — réception interne des commandes
# Optionnel : sinon CONTACT_TO puis contact@novekia.fr sont utilisés.
AUDIT_LEAD_TO=

# Checkout provider-neutral (optionnel). URL HTTPS uniquement.
# Sans URL configurée, la demande reste pending_payment et Novekia transmet
# manuellement les modalités de paiement.
NOVEKIA_AUDIT_CHECKOUT_OPTIMISATION_URL=
NOVEKIA_AUDIT_CHECKOUT_VISIBILITY_URL=
NOVEKIA_AUDIT_CHECKOUT_AUTHORITY_URL=

# Façade serveur-à-serveur du pré-audit public
# Exemple : https://<backend>/api/public/website-audit
# Variables strictement serveur : les configurer dans Preview et Production sur Vercel.
# Redéployer après tout ajout ou changement de ces variables pour recharger le runtime.
# Ne jamais préfixer le token par NEXT_PUBLIC_.
NOVEKIA_AUDIT_INGRESS_URL=
NOVEKIA_AUDIT_INGRESS_TOKEN=

# Google Search Console : jeton de validation de la balise meta
GOOGLE_SITE_VERIFICATION=
