# Formulaire de contact (ne jamais committer les valeurs réelles)
RESEND_API_KEY=
CONTACT_TO=contact@novekia.fr
CONTACT_FROM=

# Nova — disponibilité du widget et transmission des demandes
NEXT_PUBLIC_CONCIERGE_ENABLED=true
CONCIERGE_SUBMISSION_ENABLED=true

# Nova — assistance Mistral côté serveur uniquement
# Sans clé, Nova conserve automatiquement son parcours déterministe.
CONCIERGE_AI_ENABLED=true
MISTRAL_API_KEY=
MISTRAL_API_BASE_URL=https://api.eu.mistral.ai
MISTRAL_CONCIERGE_MODEL=mistral-small-2603
CONCIERGE_AI_TIMEOUT_MS=12000
CONCIERGE_AI_MAX_OUTPUT_TOKENS=700

# Google Search Console : jeton de validation de la balise meta
GOOGLE_SITE_VERIFICATION=
